BasedOnStyle: LLVM
Language: C

AllowShortCaseLabelsOnASingleLine: true
BinPackParameters: OnePerLine
BracedInitializerIndentWidth: 2
Cpp11BracedListStyle: true
# BreakAfterAttributes: Always
IndentCaseLabels: true
IndentPPDirectives: BeforeHash
PenaltyReturnTypeOnItsOwnLine: 1000
SkipMacroDefinitionBody: true
SpaceAfterCStyleCast: true
SpacesBeforeTrailingComments: 2

AlignAfterOpenBracket: true
AlignOperands: DontAlign
BreakAfterOpenBracketBracedList: true
BreakAfterOpenBracketFunction: true
BreakAfterOpenBracketIf: true
BreakBeforeCloseBracketBracedList: true
PenaltyBreakAssignment: 1000

AllowShortFunctionsOnASingleLine: Empty

Macros:
- MUON_CONST=[[gnu::const]]
- MUON_FORMAT(...)=[[gnu::format(__VA_ARGS__)]]
- MUON_MALLOC=[[gnu::malloc]]
- MUON_NONNULL=[[gnu::nonnull]]
- MUON_NONNULL_ARGS(...)=[[gnu::nonnull(__VA_ARGS__)]]
- MUON_PURE=[[gnu::pure]]
- MUON_RETURNS_NONNULL=[[gnu::returns_nonnull]]
- ON_ABSTRACT_OBJECT(x)=(x)
- "IS_CONCRETE_NODE(x)=({ x = NULL; }):"

# AllowShortBlocksOnASingleLine: Always
