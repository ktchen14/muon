#!/bin/bash
set -euo pipefail

INPLACE=false
if [[ "${1:-}" == "-i" ]]; then
  INPLACE=true
  shift
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: muon-format [-i] <file>" >&2
  exit 1
fi

FILE="$1"
TEMP=$(mktemp)
trap 'rm -f "$TEMP" "$TEMP.out"' EXIT

# Step 1: Replace all __attribute__((...)) with [[muon::sentinel(...)]]
sed -E 's/__attribute__\(\((.*)\)\)/[[muon::sentinel(\1)]]/g' "$FILE" > "$TEMP"

# Step 1b: Prepend /**/ to [[muon::sentinel(...)]] when previous line ends with )
sed -E '/\)$/ { N; s/\n([[:space:]]*)\[\[muon::sentinel/\n\1\/**\/ [[muon::sentinel/; P; D; }' "$TEMP" > "$TEMP.out"
mv "$TEMP.out" "$TEMP"

# Step 2: Run clang-format
CLANG_FORMAT=clang-format
# Use .c extension for --assume-filename so clang-format detects C, not ObjC
$CLANG_FORMAT --style=file --assume-filename="${FILE%.h}.c" < "$TEMP" > "$TEMP.out"
mv "$TEMP.out" "$TEMP"

# Step 3: Dedent "  /**/" to "/**/"
sed -E 's/^([[:space:]]*)  \/\*\*\//\1\/**\//' "$TEMP" > "$TEMP.out"
mv "$TEMP.out" "$TEMP"

# Step 4: Remove all /**/
sed -E 's/\/\*\*\/ //g' "$TEMP" > "$TEMP.out"
mv "$TEMP.out" "$TEMP"

# Step 5: Replace all [[muon::sentinel(...)]] with __attribute__((...))
sed -E 's/\[\[muon::sentinel\((.*)\)\]\]/__attribute__((\1))/g' "$TEMP" > "$TEMP.out"
mv "$TEMP.out" "$TEMP"

if [[ "$INPLACE" == true ]]; then
  cp "$TEMP" "$FILE"
else
  cat "$TEMP"
fi
